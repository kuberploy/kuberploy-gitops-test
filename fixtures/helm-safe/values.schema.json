{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["identity", "replicas"],
  "properties": {
    "identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["project", "environment", "application", "name"],
      "properties": {
        "project": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "environment": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "application": {"type": "string", "pattern": "^[0-9a-f-]{36}$"},
        "name": {"type": "string", "pattern": "^[a-z0-9](?:[-a-z0-9]*[a-z0-9])?$", "maxLength": 63}
      }
    },
    "replicas": {"type": "integer", "minimum": 1, "maximum": 10}
  }
}
